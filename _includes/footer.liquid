{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<!-- Floating footer for larger screens -->
<footer class="fixed-bottom mt-5 d-none d-md-block" role="contentinfo">
  <div class="container mt-0">
    {{ footer_contents }}
  </div>
</footer>

<!-- Fixed footer for smaller screens -->
<footer class="sticky-bottom d-block d-md-none" role="contentinfo">
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}

  <div class="container">
    {{ footer_contents }}
  </div>
</footer>
